<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. The launcher supplies the mask, so the foreground keeps the
  mark inside the 72dp safe zone and the background stays a flat colour rather
  than artwork that a circular mask would crop into nonsense.

  The monochrome layer is what Android 13+ tints for themed icons. Supplying it
  is the difference between an app that matches the user's home screen and one
  that sits on it as a foreign object.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
