<?xml version="1.0" encoding="utf-8"?>
<!--
  The window the OS paints before Flutter's first frame. It shows the mark on
  the app's own background so the launch reads as one continuous motion into the
  welcome screen rather than a white flash followed by a different app.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
